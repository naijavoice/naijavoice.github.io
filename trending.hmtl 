<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NaijaVoice – Trending This Week</title>
  <link rel="manifest" href="/manifest.json"/>
  <meta name="theme-color" content="#1a6b3c"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;0,9..144,900;1,9..144,400&family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after{box-sizing:border-box;margin:0;padding:0;}
    :root{
      --green:#1a6b3c;--green-mid:#218a4e;--green-lite:#e8f5ee;
      --gold:#c48f00;--gold-lite:#fdf6e0;
      --ink:#0f1a14;--ink-soft:#4a6355;
      --bg:#f7faf8;--white:#ffffff;
      --border:rgba(26,107,60,0.14);--radius:8px;
      --error:#c53030;
      --f-display:'Fraunces',Georgia,serif;
      --f-body:'Inter',system-ui,sans-serif;
      --f-mono:'Geist Mono',monospace;
    }
    body{font-family:var(--f-body);background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;}

    /* ── BANNER ── */
    .banner{position:sticky;top:0;z-index:200;height:54px;display:flex;align-items:center;background:var(--green);padding:0 5%;box-shadow:0 1px 0 rgba(0,0,0,0.15);}
    .banner__logo{display:flex;align-items:center;gap:8px;text-decoration:none;margin-right:10px;}
    .banner__logo-img{width:30px;height:30px;border-radius:6px;overflow:hidden;flex-shrink:0;}
    .banner__logo-img img{width:100%;height:100%;object-fit:contain;}
    .banner__logo-text{font-family:var(--f-display);font-weight:900;font-size:1.1rem;letter-spacing:-0.02em;color:#fff;}
    .banner__logo-text span{color:var(--gold);font-style:italic;}
    .banner__spacer{flex:1;}
    .banner__nav{display:flex;align-items:center;gap:4px;}
    .banner__nav a{color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.83rem;font-weight:500;padding:6px 11px;border-radius:4px;transition:background 0.15s;white-space:nowrap;}
    .banner__nav a:hover{background:rgba(255,255,255,0.12);color:#fff;}
    .banner__nav a.active{color:#fff;font-weight:700;}
    .banner__cta{background:var(--gold)!important;color:var(--ink)!important;font-weight:700!important;border-radius:5px!important;}
    .banner__user{font-size:0.83rem;color:#fff;font-weight:600;text-decoration:none;}
    .banner__logout{background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.8);font-size:0.78rem;padding:5px 10px;border-radius:4px;cursor:pointer;font-family:var(--f-body);}
    .hamburger{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:38px;height:38px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:6px;cursor:pointer;padding:8px;flex-shrink:0;}
    .hamburger span{display:block;width:17px;height:2px;background:#fff;border-radius:2px;transition:all 0.3s ease;}
    .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
    .hamburger.open span:nth-child(2){opacity:0;}
    .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
    .mobile-menu{display:none;position:fixed;top:54px;left:0;right:0;bottom:0;background:rgba(247,250,248,0.98);backdrop-filter:blur(16px);z-index:199;flex-direction:column;padding:1.5rem 5%;overflow-y:auto;transform:translateX(100%);transition:transform 0.3s ease;}
    .mobile-menu.open{transform:translateX(0);}
    .mobile-nav-links{list-style:none;display:flex;flex-direction:column;gap:0.3rem;margin-bottom:1.5rem;}
    .mobile-nav-links li a{display:flex;align-items:center;gap:0.8rem;padding:0.9rem 1rem;border-radius:10px;font-size:0.95rem;font-weight:500;color:var(--ink);text-decoration:none;transition:background 0.2s;}
    .mobile-nav-links li a:hover{background:var(--green-lite);color:var(--green);}
    .mobile-auth-area{border-top:1px solid var(--border);padding-top:1.2rem;display:flex;flex-direction:column;gap:0.8rem;}
    .mobile-auth-area a,.mobile-auth-area button{display:block;text-align:center;padding:0.85rem;border-radius:10px;font-size:0.95rem;font-weight:600;text-decoration:none;}
    .mobile-cta{background:var(--green);color:#fff!important;}
    .mobile-logout{background:transparent;border:1.5px solid var(--border);color:var(--ink-soft);cursor:pointer;font-family:var(--f-body);font-size:0.95rem;}

    /* ── PAGE HEADER ── */
    .page-header{background:var(--ink);padding:3rem 5% 2.5rem;position:relative;overflow:hidden;}
    .page-header::before{content:'';position:absolute;top:-80px;right:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(26,107,60,0.25) 0%,transparent 70%);pointer-events:none;}
    .header-inner{max-width:1000px;margin:0 auto;}
    .header-eyebrow{display:inline-flex;align-items:center;gap:6px;font-family:var(--f-mono);font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;color:#4ade80;margin-bottom:14px;}
    .page-header h1{font-family:var(--f-display);font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:900;color:#fff;margin-bottom:6px;letter-spacing:-0.025em;line-height:1.1;}
    .page-header h1 em{font-style:italic;font-weight:400;color:var(--gold);}
    .page-header p{color:rgba(255,255,255,0.45);font-size:0.9rem;max-width:480px;line-height:1.6;}

    /* ── TIME TABS ── */
    .time-tabs{display:flex;gap:8px;margin-top:1.5rem;}
    .time-tab{padding:7px 16px;border-radius:20px;border:1.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.06);font-family:var(--f-mono);font-size:11px;font-weight:600;color:rgba(255,255,255,0.6);cursor:pointer;transition:all 0.15s;letter-spacing:0.03em;}
    .time-tab.active{background:var(--green);color:#fff;border-color:var(--green);}
    .time-tab:hover{border-color:rgba(255,255,255,0.3);}

    /* ── MAIN ── */
    .main-wrap{max-width:1000px;margin:0 auto;padding:2rem 5% 4rem;}

    /* ── TRENDING LIST ── */
    .trending-list{display:flex;flex-direction:column;gap:12px;}
    .trend-card{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:18px;display:flex;align-items:flex-start;gap:16px;transition:all 0.18s;cursor:pointer;text-decoration:none;color:var(--ink);animation:fadeUp 0.4s ease both;}
    .trend-card:hover{border-color:var(--green);transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,107,60,0.1);}
    .trend-card.top{border-color:var(--gold);background:var(--gold-lite);}
    .trend-rank-wrap{display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0;min-width:48px;}
    .trend-rank{font-family:var(--f-display);font-size:1.6rem;font-weight:900;color:rgba(26,107,60,0.18);letter-spacing:-0.03em;line-height:1;}
    .trend-card.top .trend-rank{color:var(--gold);}
    .trend-momentum{font-family:var(--f-mono);font-size:9px;color:#4ade80;background:rgba(26,107,60,0.08);padding:2px 6px;border-radius:10px;letter-spacing:0.02em;white-space:nowrap;}
    .trend-body{flex:1;min-width:0;}
    .trend-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:6px;}
    .trend-cat{display:inline-flex;align-items:center;gap:4px;background:var(--green-lite);border:1px solid rgba(26,107,60,0.15);color:var(--green);font-family:var(--f-mono);font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;letter-spacing:0.03em;}
    .trend-loc{font-size:0.72rem;color:var(--ink-soft);}
    .trend-time{font-family:var(--f-mono);font-size:10px;color:var(--ink-soft);margin-left:auto;}
    .trend-title{font-family:var(--f-display);font-size:1rem;font-weight:700;color:var(--ink);line-height:1.3;margin-bottom:6px;letter-spacing:-0.015em;}
    .trend-footer{display:flex;align-items:center;gap:14px;}
    .trend-votes{font-family:var(--f-display);font-size:1rem;font-weight:900;color:var(--green);letter-spacing:-0.02em;}
    .trend-card.top .trend-votes{color:var(--gold);}
    .trend-comments{font-size:0.78rem;color:var(--ink-soft);}

    /* ── EMPTY ── */
    .empty-state{text-align:center;padding:4rem 2rem;background:var(--white);border-radius:12px;border:1px solid var(--border);}
    .empty-state .ei{font-size:3.2rem;margin-bottom:1rem;}
    .empty-state h3{font-family:var(--f-display);font-size:1.15rem;font-weight:700;color:var(--ink);margin-bottom:6px;letter-spacing:-0.015em;}
    .empty-state p{font-size:0.88rem;color:var(--ink-soft);line-height:1.6;margin-bottom:1.5rem;}
    .btn-go{display:inline-flex;align-items:center;gap:0.5rem;background:var(--green);color:#fff;padding:11px 22px;border-radius:var(--radius);font-family:var(--f-display);font-size:0.9rem;font-weight:700;text-decoration:none;}
    .loading{text-align:center;padding:3rem;color:var(--ink-soft);font-family:var(--f-mono);font-size:11px;}

    .toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(100px);background:var(--ink);color:#fff;padding:12px 24px;border-radius:50px;font-size:0.88rem;font-weight:500;box-shadow:0 8px 30px rgba(0,0,0,0.25);transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1);z-index:9999;white-space:nowrap;}
    .toast.show{transform:translateX(-50%) translateY(0);}
    @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

    @media(max-width:768px){
      .banner__nav{display:none;}
      .hamburger{display:flex;}
      .mobile-menu{display:flex;}
    }
    @media(max-width:480px){
      .trend-card{gap:12px;padding:14px;}
      .trend-rank-wrap{min-width:36px;}
      .trend-rank{font-size:1.3rem;}
    }
  </style>
</head>
<body>

<!-- ── BANNER ── -->
<header class="banner">
  <a href="index.html" class="banner__logo">
    <div class="banner__logo-img"><img src="/icon-192.png" alt="NaijaVoice"/></div>
    <span class="banner__logo-text">Naija<span>Voice</span></span>
  </a>
  <span class="banner__spacer"></span>
  <nav class="banner__nav">
    <a href="feed.html">Problems</a>
    <a href="search.html">🔍 Search</a>
    <a href="trending.html" class="active">📈 Trending</a>
    <a href="leaderboard.html">🏆 Leaderboard</a>
    <a href="updates.html">📰 Updates</a>
    <span id="nav-auth-area"><a href="auth.html" class="banner__cta">Get Started</a></span>
  </nav>
  <button class="hamburger" id="hamburger" onclick="toggleMenu()" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- ── MOBILE DRAWER ── -->
<div class="mobile-menu" id="mobile-menu">
  <ul class="mobile-nav-links">
    <li><a href="feed.html">🗳️ Problems</a></li>
    <li><a href="search.html">🔍 Search</a></li>
    <li><a href="trending.html">📈 Trending</a></li>
    <li><a href="leaderboard.html">🏆 Leaderboard</a></li>
    <li><a href="updates.html">📰 Updates</a></li>
    <li><a href="post-problem.html">✍️ Post a Problem</a></li>
  </ul>
  <div class="mobile-auth-area" id="mobile-auth-area">
    <a href="auth.html" class="mobile-cta">🚀 Get Started — Free</a>
  </div>
</div>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
  <div class="header-inner">
    <div class="header-eyebrow">📈 Gaining Fast</div>
    <h1>What's <em>Trending</em> Right Now</h1>
    <p>Problems gaining the most votes recently — separate from all-time top problems, so fresh issues get their moment.</p>
    <div class="time-tabs">
      <button class="time-tab active" onclick="setRange(7,this)">7 Days</button>
      <button class="time-tab" onclick="setRange(1,this)">24 Hours</button>
      <button class="time-tab" onclick="setRange(30,this)">30 Days</button>
    </div>
  </div>
</div>

<!-- ── MAIN ── -->
<div class="main-wrap">
  <div class="trending-list" id="trending-list">
    <div class="loading">Loading trending problems... 🇳🇬</div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="supabase.js"></script>
<script>
let allProblems=[],currentRange=7;

function showToast(msg){const t=document.getElementById('toast');t.innerHTML=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000);}
function timeAgo(ts){if(!ts)return'';const d=Math.floor((Date.now()-new Date(ts))/1000);if(d<60)return'just now';if(d<3600)return Math.floor(d/60)+'m ago';if(d<86400)return Math.floor(d/3600)+'h ago';return Math.floor(d/86400)+'d ago';}

function toggleMenu(){
  const menu=document.getElementById('mobile-menu');
  const btn=document.getElementById('hamburger');
  const isOpen=menu.classList.contains('open');
  if(isOpen){menu.classList.remove('open');btn.classList.remove('open');document.body.style.overflow='';}
  else{menu.classList.add('open');btn.classList.add('open');document.body.style.overflow='hidden';}
}
document.querySelectorAll('.mobile-nav-links a').forEach(link=>{
  link.addEventListener('click',()=>{
    document.getElementById('mobile-menu').classList.remove('open');
    document.getElementById('hamburger').classList.remove('open');
    document.body.style.overflow='';
  });
});

async function init(){
  try{
    const {data:{user}}=await sb.auth.getUser();
    if(user){
      const {data:profile}=await sb.from('profiles').select('full_name').eq('id',user.id).single();
      const name=profile?.full_name?.split(' ')[0]||'User';
      document.getElementById('nav-auth-area').innerHTML=
        '<a href="profile.html" class="banner__user">👤 '+name+'</a>'+
        '<button class="banner__logout" onclick="logout()">Logout</button>';
      document.getElementById('mobile-auth-area').innerHTML=
        '<div style="font-size:0.85rem;color:var(--ink-soft);text-align:center;padding:0.5rem 0;">👤 '+name+'</div>'+
        '<a href="profile.html" class="mobile-cta" style="background:rgba(26,107,60,0.1);color:var(--green);">My Profile</a>'+
        '<button class="mobile-logout" onclick="logout()">Logout</button>';
    }

    const {data,error}=await sb.from('problems').select('*').eq('hidden',false).order('votes',{ascending:false});
    if(!error)allProblems=data||[];
    renderTrending();
  }catch(e){console.error(e);document.getElementById('trending-list').innerHTML='<div class="loading">Error loading. Please refresh.</div>';}
}

function setRange(days,btn){
  currentRange=days;
  document.querySelectorAll('.time-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderTrending();
}

function renderTrending(){
  const cutoff=new Date(Date.now()-currentRange*24*60*60*1000).toISOString();
  const trending=allProblems
    .filter(p=>p.created_at>cutoff)
    .sort((a,b)=>(b.votes||0)-(a.votes||0));

  const container=document.getElementById('trending-list');
  if(!trending.length){
    container.innerHTML='<div class="empty-state"><div class="ei">📭</div><h3>Nothing Trending Yet</h3><p>No problems posted in this time window. Be the first to raise an issue and start the conversation.</p><a href="post-problem.html" class="btn-go">✍️ Post a Problem</a></div>';
    return;
  }

  container.innerHTML=trending.map((p,i)=>{
    const ageHours=Math.max((Date.now()-new Date(p.created_at))/3600000,1);
    const velocity=((p.votes||0)/ageHours).toFixed(1);
    return(
      '<a href="problem.html?id='+p.id+'" class="trend-card'+(i===0?' top':'')+'" style="animation-delay:'+(i*0.04)+'s">'
      +'<div class="trend-rank-wrap">'
      +'<div class="trend-rank">'+(i+1)+'</div>'
      +'<div class="trend-momentum">⚡ '+velocity+'/hr</div>'
      +'</div>'
      +'<div class="trend-body">'
      +'<div class="trend-meta">'
      +'<span class="trend-cat">'+(p.category_icon||'📋')+' '+(p.category||'General')+'</span>'
      +'<span class="trend-loc">📍 '+(p.state||'Nigeria')+(p.lga?' · '+p.lga:'')+'</span>'
      +'<span class="trend-time">'+timeAgo(p.created_at)+'</span>'
      +'</div>'
      +'<div class="trend-title">'+p.title+'</div>'
      +'<div class="trend-footer">'
      +'<span class="trend-votes">▲ '+(p.votes||0).toLocaleString()+' votes</span>'
      +'<span class="trend-comments">💬 '+(p.comment_count||0)+' comments</span>'
      +'</div>'
      +'</div>'
      +'</a>'
    );
  }).join('');
}

async function logout(){await sb.auth.signOut();window.location.reload();}
init();
</script>
<script src="/pwa.js"></script>
</body>
